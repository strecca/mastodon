FROM ruby:3.4-slim

WORKDIR /app

# System dependencies — same as dev image but without dev tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    gnupg \
    ca-certificates \
    build-essential \
    libicu-dev \
    libidn11-dev \
    ffmpeg \
    libvips42 \
    libpam-dev \
    python3 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && corepack enable \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN gem install bundler -v 4.0.10 --force --no-document

ENV RAILS_ENV=production
ENV NODE_ENV=production
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# Gems — cached layer (only invalidates when Gemfile changes)
COPY Gemfile Gemfile.lock ./
RUN bundle config set --local without 'development test' \
    && bundle install --jobs 4 --retry 3

# Node modules — cached layer (only invalidates when package.json changes)
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# Application code
COPY . .

# Compile assets for production
# SECRET_KEY_BASE_DUMMY suppresses the secret requirement during build
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

# Upload directory — must be mounted as a volume at runtime
RUN mkdir -p public/system

EXPOSE 3000 4000
