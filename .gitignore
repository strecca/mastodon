# Dependencies
node_modules/
vendor/bundle/

# Environment files — contain encryption keys and secrets, never commit
.env
.env.*
env.development

# macOS metadata
.DS_Store

# Local proxy config
priv-config

# Logs
log/*.log
log/*.pid

# Temporary files
tmp/

# Vite / asset build output — regenerated by bin/dev, do not commit
public/packs/
public/packs-dev/
public/assets/

# ActiveStorage uploads
storage/

# Paperclip uploads (avatars, media attachments, SiteUpload icons/
# thumbnails, and the hand-rolled PDF stores for Newsletters/Quick Share) —
# real user data, never commit. Was a real gap until 2026-08-07: these
# directories had been accumulating live uploads for months, untracked
# but never actually gitignored.
public/system/
public/newsletter_assets/
public/quick_share_assets/

# Bundler local config (which gem groups are installed) — machine/
# deployment-specific, not something to commit
.bundle/

# Yarn
yarn-error.log
.yarn/cache/

# Core dumps
core

# IDE
.vscode/
.idea/

# Local server setup notes and SSH keys
claude-hetzner-setup.txt
public-miacivezza-key.txt
public-miacivezza-key.txt.pub
