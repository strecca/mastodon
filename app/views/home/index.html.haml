- content_for :header_tags do
  - unless indexable_path?
    %meta{ name: 'robots', content: 'noindex' }/

  - preview = community_og_preview
  - if preview
    = render partial: 'shared/og', locals: { title: preview[:title], description: preview[:description], image_url: preview[:image_url] }
  - else
    = render partial: 'shared/og'

= render 'shared/web_app'
