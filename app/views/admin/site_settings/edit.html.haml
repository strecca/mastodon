- content_for :page_title do
  Site Content & Translations

- content_for :heading do
  %h1 Site Content &amp; Translations
  %p.lead Edit the text shown on the landing page, about page, and server banner. Fill in additional languages to enable translations.

.site-settings-auto-translate
  %span.site-settings-auto-translate__label Auto-translate all from EN →
  - (Admin::SiteSettingsController::SUPPORTED_LOCALES - ['en']).each do |locale|
    = button_to locale.upcase, auto_translate_admin_site_settings_path,
        params: { locale: locale },
        method: :post,
        class: 'site-settings-auto-translate__btn'

= form_with url: admin_site_settings_path, method: :patch, local: true do |f|
  - @groups.each do |group_name, keys|
    .site-settings-section
      %h2.site-settings-section__title= group_name
      .site-settings-cards
        - keys.each do |key|
          .site-settings-card
            .site-settings-card__key= key
            .site-settings-card__fields
              - Admin::SiteSettingsController::SUPPORTED_LOCALES.each do |locale|
                .site-settings-card__field
                  %label.site-settings-card__locale= locale.upcase
                  = text_area_tag "site_content[#{key}][#{locale}]",
                                  @content.dig(locale, key),
                                  rows: 3,
                                  class: 'site-settings-card__input',
                                  placeholder: locale == 'en' ? '(required)' : '(falls back to EN)'

  .site-settings-save
    = f.submit 'Save All Changes', class: 'button'
