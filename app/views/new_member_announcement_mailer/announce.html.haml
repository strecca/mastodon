= content_for :heading do
  = render 'application/mailer/heading',
           title: @subject,
           subtitle: 'miacivezza.com'

%table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
  %tr
    %td.email-body-huge-padding-td
      %p{ style: 'margin: 0 0 20px; color: #17063b; font-size: 24px; font-weight: 700; line-height: 32px;' }= @intro

      = render 'application/mailer/button', text: t('new_member_announcement_mailer.view_profile'), url: @new_account_url, has_arrow: true

  %tr
    %td.email-padding-24.email-padding-top-0
      %p.email-h-sub= t('new_member_announcement_mailer.current_members')
      .email-prose
        %ul
          - @member_usernames.each do |username|
            %li= "@#{username}"

  %tr
    %td.email-border-top.email-padding-24
      .email-prose
        - @reminder.split("\n\n").each do |paragraph|
          %p.email-p= paragraph
