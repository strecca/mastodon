# config/email.yml embeds a ternary (`? true : nil`) inside an ERB tag on
# consecutive lines; oxfmt's YAML parser misreads the `: ` inside the ERB
# as a nested mapping key and aborts with a SyntaxError instead of just
# leaving the file unformatted. The YAML itself is valid, working Rails
# config -- excluding it here so `format:check` can finish scanning the
# rest of the repo instead of crashing on this one file.
config/email.yml

# Auto-generated by `msw init` (see package.json's msw:updateWorker script)
# and already carries its own eslint-disable/tslint:disable headers --
# passes oxfmt --check locally but flakes red in CI on this one file for
# unclear environment-specific reasons. Not meant to be hand-formatted
# either way.
.storybook/static/mockServiceWorker.js

# This fork's own translation overrides, governed by bin/i18n-tasks
# normalize (single-quoted strings) -- oxfmt wants double quotes for the
# same lines, and the two fight forever if both are allowed to touch it.
# i18n-tasks is the domain-correct tool for Rails locale YAML; config/locales/
# (upstream's own shipped translations) isn't governed by i18n-tasks the same
# way and isn't affected by this conflict.
config/locales-glitch/
