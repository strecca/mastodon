miacivezza.com {
	@healthcheck path /health
	log_skip @healthcheck

	# Compress text responses (HTML/CSS/JS/JSON) before sending -- found
	# 2026-09-29 that this was never configured, so every response (JS
	# bundles included, ~2MB uncompressed on a fresh page load) went out
	# byte-for-byte uncompressed. Caddy skips already-compressed formats
	# (images, fonts, media) automatically, so this only affects text
	# assets, exactly the ones that dominate initial page weight.
	encode zstd gzip

	# Access logging, added 2026-09-06 -- closes an observability gap found
	# during a scanning investigation: Rails' own request log never records
	# remote_ip, so there was no way to attribute web traffic to a source IP
	# unless it happened to crash and leak one into an error message. Uses
	# Caddy's own built-in rotation (no external logrotate needed): rolls at
	# 10MB, keeps at most 10 rotated files, deletes anything older than 30
	# days -- bounds growth without needing separate maintenance.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 10
			roll_keep_for 720h
		}
	}

	# Serve uploaded media and compiled assets directly from disk — bypass Rails
	handle /system/* {
		root * /home/mastodon/live/public
		file_server
	}

	handle /packs/* {
		root * /home/mastodon/live/public
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle /packs-dev/* {
		root * /home/mastodon/live/public
		file_server
	}

	# dial_timeout/response_header_timeout only, added 2026-09-29 -- deliberately
	# no read_timeout/write_timeout here. These bound how long Caddy waits for
	# the connection to open and for the initial response (the WebSocket
	# upgrade handshake), not the lifetime of the connection after that --
	# streaming clients are meant to sit open and mostly silent for a long
	# time, and a read/write timeout would kill those legitimately-idle
	# connections instead of just catching a genuinely dead upstream.
	handle /api/v1/streaming* {
		reverse_proxy localhost:4000 {
			header_up Upgrade {http.upgrade}
			header_up Connection {http.upgrade}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle /api/v2/streaming* {
		reverse_proxy localhost:4000 {
			header_up Upgrade {http.upgrade}
			header_up Connection {http.upgrade}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Service worker must never be cached — always re-fetch so stale clients
	# get the updated SW that clears old asset caches after each deploy.
	# Without this, Safari holds stale SW → old asset hashes → black page.
	#
	# root is /public/packs, not /public -- Vite's build config (vite.config.mts,
	# entryFileNames) intentionally outputs the sw entry unhashed as
	# packs/sw.js, but the app registers it from the site root ('/sw.js', in
	# main.tsx) so its scope covers the whole site, not just /packs/. This
	# block bridges that gap. Found 2026-09-18: this was pointed at the wrong
	# root (plain /public) since whenever it was first added, meaning /sw.js
	# 404'd for every visitor the whole time -- the service worker never
	# actually registered for anyone, regardless of any app-side code.
	handle /sw.js {
		root * /home/mastodon/live/public/packs
		file_server
		header Cache-Control "no-store"
	}

	# Same dial_timeout/response_header_timeout reasoning as the streaming
	# blocks above -- bounds a genuinely hung Rails request (slow query,
	# stuck external API call) to a fast 502 instead of leaving the visitor
	# waiting indefinitely, without touching normal long-poll/slow-network
	# behavior since this only covers time-to-first-response-byte.
	handle {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}
